---
const { mode = 'create' } = Astro.props
---
<form id="cliente-form" class="space-y-5" novalidate>
  <div class="grid gap-5 sm:grid-cols-2"><label class="block text-sm font-semibold">Nombre completo<input name="nombreCliente" class="mt-2 w-full rounded-md border border-neutral-300 bg-white px-4 py-3 outline-none focus:border-brand-red focus:ring-2 focus:ring-red-100" placeholder="Nombre del cliente" /></label><label class="block text-sm font-semibold">Teléfono<input name="telefono" inputmode="numeric" maxlength="8" class="mt-2 w-full rounded-md border border-neutral-300 bg-white px-4 py-3 outline-none focus:border-brand-red focus:ring-2 focus:ring-red-100" placeholder="70000000" /></label><label class="block text-sm font-semibold">Monto de pago (Bs)<input name="montoPago" type="number" min="0" max="10000" step="0.01" class="mt-2 w-full rounded-md border border-neutral-300 bg-white px-4 py-3 outline-none focus:border-brand-red focus:ring-2 focus:ring-red-100" placeholder="250" /></label><label class="block text-sm font-semibold">Tipo de entrada<select name="tipoEntrada" class="mt-2 w-full rounded-md border border-neutral-300 bg-white px-4 py-3 outline-none focus:border-brand-red focus:ring-2 focus:ring-red-100"><option value="mensual">Mensual</option><option value="semanal">Semanal</option><option value="sesión">Sesión</option></select></label><label class="block text-sm font-semibold sm:col-span-2">Tipo de pago<select name="tipoPago" class="mt-2 w-full rounded-md border border-neutral-300 bg-white px-4 py-3 outline-none focus:border-brand-red focus:ring-2 focus:ring-red-100"><option value="efectivo">Efectivo</option><option value="QR">Por QR</option></select></label></div>
  <div id="form-error" class="hidden rounded-md bg-red-50 p-3 text-sm text-red-700"></div><div id="form-success" class="hidden rounded-md bg-green-50 p-3 text-sm text-green-700"></div><button type="submit" class="rounded-md bg-brand-red px-6 py-3 text-sm font-bold text-white hover:bg-red-700 disabled:opacity-60">{mode === 'edit' ? 'Guardar cambios' : 'Registrar cliente'}</button>
</form>
