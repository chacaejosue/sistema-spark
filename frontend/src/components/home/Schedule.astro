---
---
<section id="horarios" class="bg-brand-black px-6 py-20 text-white lg:px-10">
  <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[0.8fr_1.4fr]">
    <div data-reveal>
      <p class="section-label">Horarios <span class="ml-2 inline-flex items-center gap-1.5 normal-case tracking-normal"><span data-gym-status-dot class="status-dot" aria-hidden="true"></span><span data-gym-status>Consultando...</span></span></p>
      <h2 class="display-title mt-3 text-5xl sm:text-6xl">Nuestras clases</h2>
      <p class="mt-5 max-w-sm text-sm leading-7 text-neutral-400">Entrena a tu ritmo con horarios flexibles para que encuentres tu espacio.</p>
      <a href="#contacto" class="mt-8 inline-flex rounded-md border border-brand-red px-5 py-3 text-sm font-bold text-white hover:bg-brand-red">Ver ubicación <span class="ml-2">→</span></a>
    </div>
    <div data-reveal class="overflow-hidden rounded-lg border border-white/20">
      <table class="w-full text-left text-sm">
        <thead class="bg-white/10 text-xs uppercase tracking-widest text-neutral-300"><tr><th class="px-4 py-4">Día</th><th class="px-4 py-4">Horario</th></tr></thead>
        <tbody class="divide-y divide-white/10 text-neutral-300"><tr data-day="weekday"><td class="px-4 py-4 font-semibold text-white">Lunes - Viernes</td><td class="px-4 py-4">06:00 - 22:30</td></tr><tr data-day="saturday"><td class="px-4 py-4 font-semibold text-white">Sábado</td><td class="px-4 py-4">08:00 - 20:00</td></tr><tr data-day="sunday"><td class="px-4 py-4 font-semibold text-white">Domingo</td><td class="px-4 py-4">08:00 - 12:00</td></tr></tbody>
      </table>
    </div>
  </div>
</section>
