---
import '../styles/global.css'
import { inject } from '@vercel/analytics'
const { title = 'Panel administrativo | Spark Fit Center' } = Astro.props
inject()
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-[#f3f3f1]">
    <div data-scroll-progress class="scroll-progress" aria-hidden="true"></div>
    <slot />
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
