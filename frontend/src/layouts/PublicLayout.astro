---
import '../styles/global.css'
import Analytics from '@vercel/analytics/astro'
const { title = 'Spark Fit Center | Entrena con propósito' } = Astro.props
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Spark Fit Center: fuerza, disciplina y comunidad en Camiri." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Analytics />
    <title>{title}</title>
  </head>
  <body>
    <div data-scroll-progress class="scroll-progress" aria-hidden="true"></div>
    <slot />
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
