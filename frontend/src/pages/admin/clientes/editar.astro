---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import AdminNav from '../../../components/admin/AdminNav.astro'
import ClienteForm from '../../../components/clientes/ClienteForm.astro'
---
<AdminLayout title="Editar cliente | Spark Fit Center"><AdminNav /><main class="mx-auto max-w-3xl px-6 py-12 lg:px-10"><a href="/admin/clientes" class="text-sm font-semibold text-neutral-500 hover:text-brand-red">← Volver a clientes</a><p class="section-label mt-10">Actualizar registro</p><h1 class="display-title mt-3 text-6xl">Editar cliente</h1><p class="mt-3 text-sm text-neutral-600">Actualiza la información del miembro seleccionado.</p><div class="mt-10 rounded-xl bg-white p-6 shadow-sm sm:p-8"><ClienteForm mode="edit" /></div></main><script>
  import { listClientes, updateCliente } from '../../../lib/api'
  import { clienteFormSchema } from '../../../schemas/cliente.schema'
  const id = Number(new URLSearchParams(window.location.search).get('id')); const form = document.querySelector<HTMLFormElement>('#cliente-form'); const error = document.querySelector<HTMLElement>('#form-error'); const success = document.querySelector<HTMLElement>('#form-success')
  if (form && Number.isInteger(id) && id > 0) { try { const result = await listClientes(new URLSearchParams({ limit: '100' })); const client = result.data.find((item) => item.idCliente === id); if (!client) throw new Error('Cliente no encontrado'); for (const [key, value] of Object.entries(client)) { const field = form.elements.namedItem(key) as HTMLInputElement | HTMLSelectElement | null; if (field && key !== 'idCliente' && key !== 'fechaRegistro') field.value = String(value) } } catch (requestError) { if (error) { error.textContent = requestError instanceof Error ? requestError.message : 'No se pudo cargar el cliente'; error.classList.remove('hidden') } } }
  form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!form || !error || !success) return; error.classList.add('hidden'); success.classList.add('hidden'); if (!Number.isInteger(id) || id <= 0) { error.textContent = 'El cliente seleccionado no es válido'; error.classList.remove('hidden'); return }; const parsed = clienteFormSchema.partial().safeParse(Object.fromEntries(new FormData(form))); if (!parsed.success) { error.textContent = parsed.error.issues[0]?.message ?? 'Revisa los datos'; error.classList.remove('hidden'); return }; const button = form.querySelector('button') as HTMLButtonElement; button.disabled = true; try { await updateCliente(id, parsed.data); success.textContent = 'Cambios guardados correctamente.'; success.classList.remove('hidden') } catch (requestError) { error.textContent = requestError instanceof Error ? requestError.message : 'No se pudo actualizar el cliente'; error.classList.remove('hidden') } finally { button.disabled = false } })
</script></AdminLayout>
