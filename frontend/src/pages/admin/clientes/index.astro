---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import AdminNav from '../../../components/admin/AdminNav.astro'
---

<AdminLayout title="Clientes | Spark Fit Center">
  <AdminNav />
  <main class="mx-auto max-w-7xl px-6 py-12 lg:px-10">
    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div>
        <p class="section-label">Administración</p>
        <h1 class="display-title mt-3 text-6xl">Clientes</h1>
        <p class="mt-3 text-sm text-neutral-600">Consulta y gestiona los miembros de Spark Fit Center.</p>
      </div>
      <a href="/admin/clientes/nuevo" class="rounded-md bg-brand-red px-5 py-3 text-center text-sm font-bold text-white hover:bg-red-700">+ Registrar cliente</a>
    </div>

    <form id="filters" class="mt-10 grid gap-3 rounded-xl bg-white p-5 shadow-sm sm:grid-cols-2 lg:grid-cols-7">
      <input name="nombreCliente" placeholder="Buscar por nombre" class="rounded-md border border-neutral-200 px-3 py-2.5 text-sm outline-none focus:border-brand-red" />
      <input name="telefono" maxlength="8" placeholder="Teléfono" class="rounded-md border border-neutral-200 px-3 py-2.5 text-sm outline-none focus:border-brand-red" />
      <select name="tipoEntrada" class="rounded-md border border-neutral-200 px-3 py-2.5 text-sm outline-none focus:border-brand-red"><option value="">Todas las entradas</option><option value="mensual">Mensual</option><option value="semanal">Semanal</option><option value="sesión">Sesión</option></select>
      <select name="tipoPago" class="rounded-md border border-neutral-200 px-3 py-2.5 text-sm outline-none focus:border-brand-red"><option value="">Todos los pagos</option><option value="efectivo">Efectivo</option><option value="QR">Por QR</option></select>
      <input type="date" name="fechaDesde" aria-label="Fecha desde" class="rounded-md border border-neutral-200 px-3 py-2.5 text-sm outline-none focus:border-brand-red" />
      <input type="date" name="fechaHasta" aria-label="Fecha hasta" class="rounded-md border border-neutral-200 px-3 py-2.5 text-sm outline-none focus:border-brand-red" />
      <button type="submit" class="rounded-md bg-brand-black px-4 py-2.5 text-sm font-bold text-white hover:bg-brand-red">Filtrar</button>
      <button id="clear-filters" type="button" class="rounded-md border border-neutral-300 bg-white px-4 py-2.5 text-sm font-bold text-neutral-700 hover:border-brand-red hover:text-brand-red">Limpiar filtros</button>
    </form>

    <div id="list-error" class="mt-5 hidden rounded-md bg-red-50 p-3 text-sm text-red-700"></div>
    <div class="mt-5 overflow-x-auto rounded-xl bg-white shadow-sm">
      <table class="w-full min-w-[760px] text-left text-sm">
        <thead class="border-b border-neutral-200 bg-neutral-50 text-xs uppercase tracking-wider text-neutral-500"><tr><th class="px-5 py-4">Cliente</th><th class="px-5 py-4">Teléfono</th><th class="px-5 py-4">Entrada</th><th class="px-5 py-4">Pago</th><th class="px-5 py-4">Fecha</th><th class="px-5 py-4">Acción</th></tr></thead>
        <tbody id="clients-body" class="divide-y divide-neutral-100"></tbody>
      </table>
      <div id="empty-state" class="hidden p-12 text-center text-sm text-neutral-500">No encontramos clientes con esos filtros.</div>
    </div>
    <p id="total" class="mt-4 text-sm text-neutral-500"></p>
    <div id="pagination" class="mt-4 flex items-center justify-between gap-4 text-sm" hidden>
      <button id="previous-page" type="button" class="rounded-md border border-neutral-300 px-4 py-2 font-semibold text-neutral-700 hover:border-brand-red hover:text-brand-red disabled:cursor-not-allowed disabled:opacity-40">Anterior</button>
      <span id="page-status" class="text-neutral-500"></span>
      <button id="next-page" type="button" class="rounded-md border border-neutral-300 px-4 py-2 font-semibold text-neutral-700 hover:border-brand-red hover:text-brand-red disabled:cursor-not-allowed disabled:opacity-40">Siguiente</button>
    </div>
  </main>

  <script>
    import { listClientes } from '../../../lib/api'
    import { clienteFilterSchema } from '../../../schemas/cliente.schema'

    const form = document.querySelector<HTMLFormElement>('#filters')
    const body = document.querySelector<HTMLTableSectionElement>('#clients-body')
    const empty = document.querySelector<HTMLElement>('#empty-state')
    const total = document.querySelector<HTMLElement>('#total')
    const error = document.querySelector<HTMLElement>('#list-error')
    const pagination = document.querySelector<HTMLElement>('#pagination')
    const previousPage = document.querySelector<HTMLButtonElement>('#previous-page')
    const nextPage = document.querySelector<HTMLButtonElement>('#next-page')
    const pageStatus = document.querySelector<HTMLElement>('#page-status')
    const clearFilters = document.querySelector<HTMLButtonElement>('#clear-filters')
    const money = (value: string | number) => `${Number(value).toFixed(2)} Bs`
    const pageSize = 20
    let activeParams = new URLSearchParams()
    let requestVersion = 0

    const escapeHtml = (value: unknown) => String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;')

    const formatDate = (value: string) => {
      const date = new Date(`${String(value).slice(0, 10)}T00:00:00`)
      return Number.isNaN(date.getTime()) ? '—' : date.toLocaleDateString('es-BO')
    }

    const render = async (params = new URLSearchParams()) => {
      if (!body || !empty || !total || !error) return
      const version = ++requestVersion
      activeParams = new URLSearchParams(params)
      error.classList.add('hidden')
      empty.classList.add('hidden')
      total.textContent = ''
      if (pagination) pagination.hidden = true
      body.innerHTML = '<tr><td colspan="6" class="px-5 py-10 text-center text-neutral-500">Cargando clientes...</td></tr>'
      try {
        const result = await listClientes(params)
        if (version !== requestVersion) return
        body.innerHTML = result.data.map((client) => `<tr><td class="px-5 py-4 font-semibold">${escapeHtml(client.nombreCliente)}</td><td class="px-5 py-4 text-neutral-600">${escapeHtml(client.telefono)}</td><td class="px-5 py-4"><span class="rounded-full bg-red-50 px-3 py-1 text-xs font-semibold text-brand-red">${escapeHtml(client.tipoEntrada)}</span></td><td class="px-5 py-4">${money(client.montoPago)}<br><span class="text-xs text-neutral-500">${escapeHtml(client.tipoPago)}</span></td><td class="px-5 py-4 text-neutral-600">${formatDate(client.fechaRegistro)}</td><td class="px-5 py-4"><a href="/admin/clientes/editar?id=${encodeURIComponent(String(client.idCliente))}" class="font-semibold text-brand-red hover:underline">Editar</a></td></tr>`).join('')
        empty.classList.toggle('hidden', result.data.length > 0)
        total.textContent = `${result.total} cliente${result.total === 1 ? '' : 's'} encontrado${result.total === 1 ? '' : 's'}`
        const offset = Number(params.get('offset') ?? 0)
        const hasPrevious = offset > 0
        const hasNext = offset + result.data.length < result.total
        if (pagination && pageStatus && previousPage && nextPage) {
          pagination.hidden = result.total <= pageSize
          previousPage.disabled = !hasPrevious
          nextPage.disabled = !hasNext
          pageStatus.textContent = `Página ${Math.floor(offset / pageSize) + 1} de ${Math.max(1, Math.ceil(result.total / pageSize))}`
        }
      } catch (requestError) {
        if (version !== requestVersion) return
        body.innerHTML = ''
        empty.classList.add('hidden')
        total.textContent = ''
        error.textContent = requestError instanceof Error ? requestError.message : 'No se pudo cargar la lista'
        error.classList.remove('hidden')
      }
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault()
      const parsed = clienteFilterSchema.safeParse(Object.fromEntries(new FormData(form)))
      if (!parsed.success) {
        if (error) { error.textContent = parsed.error.issues[0]?.message ?? 'Filtro inválido'; error.classList.remove('hidden') }
        return
      }
      const params = new URLSearchParams()
      Object.entries(parsed.data).forEach(([key, value]) => { if (value) params.set(key, String(value)) })
      params.set('limit', String(pageSize))
      params.set('offset', '0')
      render(params)
    })

    clearFilters?.addEventListener('click', () => {
      form?.reset()
      render(new URLSearchParams())
    })

    previousPage?.addEventListener('click', () => {
      const offset = Math.max(0, Number(activeParams.get('offset') ?? 0) - pageSize)
      const params = new URLSearchParams(activeParams)
      params.set('offset', String(offset))
      render(params)
    })

    nextPage?.addEventListener('click', () => {
      const offset = Number(activeParams.get('offset') ?? 0) + pageSize
      const params = new URLSearchParams(activeParams)
      params.set('offset', String(offset))
      render(params)
    })

    render()
  </script>
</AdminLayout>
