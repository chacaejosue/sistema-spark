---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import AdminNav from '../../../components/admin/AdminNav.astro'
import ClienteForm from '../../../components/clientes/ClienteForm.astro'
---
<AdminLayout title="Registrar cliente | Spark Fit Center"><AdminNav /><main class="mx-auto max-w-3xl px-6 py-12 lg:px-10"><a href="/admin/clientes" class="text-sm font-semibold text-neutral-500 hover:text-brand-red">← Volver a clientes</a><p class="section-label mt-10">Nuevo registro</p><h1 class="display-title mt-3 text-6xl">Registrar cliente</h1><p class="mt-3 text-sm text-neutral-600">Completa la información del nuevo miembro.</p><div class="mt-10 rounded-xl bg-white p-6 shadow-sm sm:p-8"><ClienteForm /></div></main><script>
  import { createCliente } from '../../../lib/api'
  import { clienteFormSchema } from '../../../schemas/cliente.schema'
  const form = document.querySelector<HTMLFormElement>('#cliente-form'); const error = document.querySelector<HTMLElement>('#form-error'); const success = document.querySelector<HTMLElement>('#form-success')
  form?.addEventListener('submit', async (event) => { event.preventDefault(); if (!form || !error || !success) return; error.classList.add('hidden'); success.classList.add('hidden'); const parsed = clienteFormSchema.safeParse(Object.fromEntries(new FormData(form))); if (!parsed.success) { error.textContent = parsed.error.issues[0]?.message ?? 'Revisa los datos'; error.classList.remove('hidden'); return }; const button = form.querySelector('button') as HTMLButtonElement; button.disabled = true; try { await createCliente(parsed.data); success.textContent = 'Cliente registrado correctamente.'; success.classList.remove('hidden'); form.reset() } catch (requestError) { error.textContent = requestError instanceof Error ? requestError.message : 'No se pudo registrar el cliente'; error.classList.remove('hidden') } finally { button.disabled = false } })
</script></AdminLayout>
